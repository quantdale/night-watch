{
  "name": "nightwatch",
  "version": "0.1.0",
  "private": true,
  "description": "Private local autonomous bug-hunting and evidence-triage framework for Alphaus products",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test tests/unit",
    "test:smoke": "playwright test tests/smoke",
    "typecheck": "tsc --noEmit",
    "hardening:check": "node bin/hardening-check.mjs",
    "test:owner-provenance": "playwright test tests/unit/privateArtifactAtomic.test.ts tests/unit/aiOwnerReview.test.ts tests/unit/aiReview.test.ts --project=nightwatch --workers=1",
    "agent:check": "node bin/agent-state.mjs",
    "agent:audit": "node bin/agent-state.mjs --audit-history",
    "project:check": "node bin/project-state-check.mjs",
    "status:local": "node bin/nightwatch-status.mjs",
    "nightwatch": "node bin/nightwatch.mjs",
    "nightwatch:status": "node bin/nightwatch-intelligence.mjs status",
    "campaign:plan": "node bin/nightwatch-intelligence.mjs plan",
    "campaign:coverage": "node bin/nightwatch-intelligence.mjs coverage",
    "campaign:contracts": "node bin/nightwatch-intelligence.mjs contracts",
    "campaign:gaps": "node bin/nightwatch-intelligence.mjs gaps",
    "campaign:operator": "node bin/nightwatch-intelligence.mjs campaign",
    "campaign:findings": "node bin/nightwatch-intelligence.mjs findings",
    "observe:preflight": "node bin/observe-preflight.mjs",
    "observe:gate": "node bin/observe-gate.mjs",
    "observe:canary": "node bin/observe-canary.mjs",
    "observe:authenticated": "node bin/observe-authenticated.mjs",
    "journey:real": "node bin/phase2b-real.mjs",
    "journey:phase2c": "node bin/phase2c-real.mjs",
    "phase9b:real": "node bin/phase9b-real.mjs",
    "phase10b:real": "node bin/phase10b-real.mjs",
    "change:shadow": "node bin/change-intelligence.mjs",
    "explore:phase4": "node bin/phase4-real.mjs",
    "api:phase5": "node bin/phase5-real.mjs",
    "campaign:synthetic": "playwright test tests/unit/campaign.test.ts --workers=1",
    "selfdev:synthetic": "node bin/selfdev-synthetic.mjs",
    "selfdev:verify": "node bin/selfdev-verify.mjs",
    "selfdev:adopt-sandbox": "node bin/selfdev-adopt-sandbox.mjs",
    "selfdev:promote-canonical": "node bin/selfdev-promote-canonical.mjs",
    "campaign:real": "node bin/phase7-real.mjs",
    "dev-preflight": "node bin/phase22-dev.mjs preflight",
    "dev-manifest": "node bin/phase22-dev.mjs manifest",
    "dev-acceptance": "node bin/phase22-dev.mjs acceptance",
    "dev-results": "node bin/phase22-dev.mjs results",
    "dev-explain": "node bin/phase22-dev.mjs explain",
    "ai:local-canary": "node bin/ai-local-canary.mjs",
    "ai:owner-review": "node bin/ai-owner-review.mjs",
    "auth:capture": "node bin/auth-capture.mjs",
    "auth:configure": "node bin/auth-configure.mjs",
    "scenario": "node bin/nightwatch.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vue": "2.6.12"
  }
}
