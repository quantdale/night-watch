# ---------------------------------------------------------------------------
# Nightwatch environment configuration (Phase 0/1)
# Copy to `.env` if you want local defaults — NEVER commit `.env`.
# All values below are placeholders. Credentials are NEVER stored in this
# repository; authentication state, when used at all, is referenced by FILE
# PATH only (see NIGHTWATCH_STORAGE_STATE).
# ---------------------------------------------------------------------------

# Fail-closed environment selection: one of local | dev | next.
# production is NOT supported in Phase 1. Missing value => DENY at startup.
NIGHTWATCH_ENV=local

# Override the UI base URL for the selected environment.
# The host MUST still pass the outbound-request policy (allowlist) of the
# selected environment; anything else is rejected at run start.
# When unset for `local`, the built-in fixture server is used (safe default).
NIGHTWATCH_UI_URL=

# Optional: absolute path to a Playwright storageState JSON file
# (e.g. produced by `playwright codegen --save-storage`).
# NEVER point this at credentials inside the repository.
# When unset, Nightwatch runs in clearly-marked UNAUTHENTICATED mode.
NIGHTWATCH_STORAGE_STATE=

# Repository snapshot scope (Phase 1).
# Root of the Alphaus repositories (default: parent of the nightwatch dir,
# i.e. REPOSITORIES/). The snapshotter is strictly read-only.
NIGHTWATCH_REPOS_ROOT=

# Comma-separated relative repo paths to track (default: every repo under
# REPOSITORIES/alphauslabs and REPOSITORIES/mobingilabs).
NIGHTWATCH_TRACKED_REPOS=

# Deterministic run id override (tests use this for reproducibility).
NIGHTWATCH_RUN_ID=

# Trace control: 'on' | 'off'. Traces are disabled automatically whenever
# authenticated state is loaded (traces can contain request headers/cookies).
NIGHTWATCH_TRACE=
