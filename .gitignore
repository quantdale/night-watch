# dependencies
node_modules/

# build output
dist/

# test runner output
test-results/
test-results-*/

# run artifacts (evidence is never committed)
artifacts/*
!artifacts/.gitkeep

# owner-only private findings should remain outside Git even if a test/operator
# explicitly injects a repository-local root
.nightwatch/

# test fixtures / scratch
.tmp-*/

# secrets
.env
*.local.json

# auth/session files — secret material, never committed (defensive; Phase 1.1)
*.storage-state.json
*.storage-state
storage-state*.json
storageState*.json
auth-state*.json
auth*.json

# The `auth*.json` rule above keeps authentication STATE out of Git; it is a
# defensive secret glob and must stay. It also matches the tracked
# certification receipt `evidence/certification/<S>/authenticated-capability-lifecycle.json`,
# which is NOT authentication state: it records that the F-21 lifecycle
# evaluator refused five synthetic non-VALID artefacts, carries no secret,
# and is the tracked evidence a clean clone must be able to read. Re-include
# it explicitly so a secret-shaped name can never silently swallow tracked
# certification evidence (15.C: BINDING_RECEIPT_UNVERIFIED in a clean clone).
!evidence/certification/**/*.json

session*.json
*.cookies.json
cookies*.json
*credentials*.json
credentials/
.secrets/
*.token
*.tokens.json

# authenticated capability lifecycle records (non-secret metadata; never committed)
*.auth-lifecycle.json
*.auth-lifecycle.json.*

# misc
*.log
.DS_Store
