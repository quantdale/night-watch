{
  "schemaVersion": "nightwatch.provider-resilience-policy.v1",
  "campaignId": "nightwatch-provider-resilient-current-yield-w13-v1",
  "declaredBeforeProbe": true,
  "orderingCriteria": [
    "already configured in the live opencode CLI model registry",
    "compatible with the production print adapter and typed turn protocol",
    "owner-approved subscribed provider family",
    "sufficient context for bounded current-source requests",
    "predecessor continuity (the W11/W12 subscribed model remains first) without using any predecessor result quality"
  ],
  "qualityBasedSelection": false,
  "cli": {
    "mode": "existing-configured-reasoner-cli",
    "adapter": "bin/nightwatch-reasoner-print.mjs",
    "shell": false,
    "structuredResponseSchema": "nightwatch.reasoner-turn-response.v1"
  },
  "timing": {
    "probeTimeoutMs": 30000,
    "runtimeTimeoutMs": 120000
  },
  "retryPolicy": {
    "attemptsPerCall": 1,
    "note": "a failed call is classified and feeds the frozen consecutive-failure threshold instead of being retried in place; failover replaces blind retry"
  },
  "failover": {
    "eligibleClasses": [
      "PROVIDER_ABSENT",
      "PROVIDER_PROBE_TIMEOUT",
      "PROVIDER_RUNTIME_TIMEOUT",
      "PROVIDER_NONZERO_EXIT",
      "PROVIDER_INVALID_STRUCTURED_RESPONSE",
      "PROVIDER_NAMESPACE_OR_QUOTA_UNAVAILABLE",
      "PROVIDER_AUTH_FAILURE",
      "UNKNOWN_EXTERNAL_PROVIDER_FAILURE"
    ],
    "ineligibleClasses": [
      "LOCAL_CLI_FAILURE"
    ],
    "maxConsecutiveFailuresByClass": {
      "DEFAULT": 3,
      "PROVIDER_ABSENT": 1,
      "PROVIDER_PROBE_TIMEOUT": 1,
      "PROVIDER_AUTH_FAILURE": 1,
      "PROVIDER_NAMESPACE_OR_QUOTA_UNAVAILABLE": 1
    },
    "maxTransitions": 4,
    "recovery": {
      "permitted": false
    },
    "exhaustionBehavior": "PROVIDER_BLOCKED"
  },
  "budgetEnvelope": {
    "schemaVersion": "nightwatch.runtime-budget-envelope.v1",
    "ceilingName": "HOUR_1",
    "reasonerCalls": 200,
    "toolActions": 400,
    "inputBytes": 5000000,
    "outputBytes": 160000,
    "toolPayloadBytes": 64000000,
    "retries": 8,
    "consecutiveFailures": 6,
    "providerFailures": 8
  },
